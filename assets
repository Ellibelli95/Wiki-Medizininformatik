
:root {
  --blue-900:#102a43;
  --blue-700:#1a5276;
  --blue-500:#2b7a9b;
  --blue-100:#eaf4f8;
  --bg:#f5f8fb;
  --text:#17212b;
  --muted:#5f6f7c;
  --white:#fff;
  --border:#d9e2ea;
}
* { box-sizing:border-box; }
body {
  margin:0; font-family:Arial, Helvetica, sans-serif;
  background:var(--bg); color:var(--text); line-height:1.65;
}
header {
  background:linear-gradient(135deg,var(--blue-900),var(--blue-700));
  color:white; padding:28px 20px;
}
.header-inner { max-width:1200px; margin:auto; }
header h1 { margin:0 0 5px; font-size:clamp(1.7rem,4vw,2.6rem); }
header p { margin:0; opacity:.9; }
nav {
  background:white; border-bottom:1px solid var(--border);
  position:sticky; top:0; z-index:10;
}
.nav-inner {
  max-width:1200px; margin:auto; padding:10px 16px;
  display:flex; gap:8px; overflow:auto;
}
.nav-inner a {
  white-space:nowrap; text-decoration:none; color:var(--blue-900);
  padding:8px 12px; border-radius:8px; font-weight:700;
}
.nav-inner a:hover { background:var(--blue-100); }
main { max-width:1200px; margin:0 auto; padding:35px 20px 60px; }
.breadcrumb { color:var(--muted); margin-bottom:20px; font-size:.95rem; }
.breadcrumb a { color:var(--blue-700); }
.hero {
  background:white; border:1px solid var(--border); border-radius:16px;
  padding:30px; box-shadow:0 5px 20px rgba(16,42,67,.06);
}
h2 { color:var(--blue-900); margin-top:0; }
.grid {
  display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:16px; margin-top:25px;
}
.card {
  display:block; text-decoration:none; color:inherit; background:white;
  border:1px solid var(--border); border-radius:14px; padding:20px;
  transition:.2s; box-shadow:0 3px 12px rgba(16,42,67,.05);
}
.card:hover { transform:translateY(-3px); border-color:var(--blue-500); }
.card h3 { margin:0 0 7px; color:var(--blue-700); }
.card p { margin:0; color:var(--muted); font-size:.95rem; }
.flow {
  background:#0f2638; color:#eaf4f8; border-radius:12px;
  padding:20px; overflow:auto; font-family:Consolas,monospace;
}
.note { background:var(--blue-100); border-left:4px solid var(--blue-500); padding:15px 18px; border-radius:8px; }
footer { text-align:center; color:var(--muted); padding:25px; border-top:1px solid var(--border); }
@media (max-width:600px) { main{padding:25px 14px 45px}.hero{padding:22px}.grid{grid-template-columns:1fr} }
